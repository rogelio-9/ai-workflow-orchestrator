# The gateway this app proxies to. Server-side only -- see app/api/graphql/route.ts.
GATEWAY_URL=http://localhost:4000/graphql

# A short-lived development token. There is no login flow yet, so mint one:
#
#   JWT_SECRET=$(grep ^JWT_SECRET ../.env | cut -d= -f2-) \
#     ../services/api-gateway/.venv/bin/python ../scripts/mint_token.py <your-user-uuid>
#
# Deliberately a token and not JWT_SECRET: this app should be able to call the
# gateway, not to sign arbitrary identities. A leaked token expires in hours;
# a leaked signing key lets anyone mint any user.
DEV_TOKEN=
