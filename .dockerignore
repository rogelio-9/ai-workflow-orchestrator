# llm-gateway builds from the repo root to reach gen/, so without this the
# venv, git history, and Postgres volume ship to the daemon on every build.

.git/
.gitignore

# Python
**/.venv/
**/venv/
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.mypy_cache/
**/*.egg-info/

# Node
**/node_modules/
**/.next/

# Secrets & data
.env
.env.local
*.pem
postgres_data/
*.log

# OS / editor
**/.DS_Store
.idea/
.vscode/
